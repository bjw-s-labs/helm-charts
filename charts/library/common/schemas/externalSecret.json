{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bjw-s-labs/helm-charts/common-5.1.0/charts/library/common/schemas/externalSecret.json",
  "$defs": {
    "instance": {
      "type": "object",
      "allOf": [
        {
          "$ref": "definitions.json#/$defs/resourceIdentifier"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "enabled": {
          "description": "Set to false to disable the ExternalSecret.",
          "type": "boolean",
          "default": true
        },
        "annotations": {
          "$ref": "definitions.json#/$defs/annotations"
        },
        "labels": {
          "$ref": "definitions.json#/$defs/labels"
        },
        "refreshPolicy": {
          "description": "Policy controlling when the ExternalSecret is refreshed.",
          "type": "string",
          "enum": [
            "CreatedOnce",
            "Periodic",
            "OnChange"
          ]
        },
        "refreshInterval": {
          "description": "Amount of time before values are read again from the SecretStore provider.",
          "type": "string"
        },
        "secretStoreRef": {
          "description": "SecretStore or ClusterSecretStore to fetch secret data from. Values override defaultExternalSecretStoreRef.",
          "$ref": "#/$defs/secretStoreRef"
        },
        "syncWindows": {
          "description": "Time windows restricting when periodic refreshes may occur. See https://external-secrets.io/latest/api/externalsecret/ for details.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "description": "Whether the windows allow or deny periodic refreshes.",
              "type": "string",
              "enum": [
                "allow",
                "deny"
              ]
            },
            "windows": {
              "description": "Schedule and duration pairs defining the refresh windows.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schedule": {
                    "description": "Cron schedule evaluated in UTC.",
                    "type": "string"
                  },
                  "duration": {
                    "description": "Duration for which the window remains active.",
                    "type": "string"
                  }
                },
                "required": [
                  "schedule",
                  "duration"
                ]
              }
            }
          },
          "required": [
            "kind",
            "windows"
          ]
        },
        "target": {
          "description": "Target Secret configuration. The deletionPolicy defaults to Delete, overriding ESO's Retain default. For more details, see https://external-secrets.io/latest/api/externalsecret/.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "creationPolicy": {
              "description": "Policy controlling how the target Secret is created.",
              "type": "string",
              "enum": [
                "Owner",
                "Orphan",
                "Merge",
                "None",
                "CreateOrMerge"
              ],
              "default": "Owner"
            },
            "deletionPolicy": {
              "description": "Policy controlling what happens to the target Secret when provider data is deleted.",
              "type": "string",
              "enum": [
                "Delete",
                "Merge",
                "Retain"
              ],
              "default": "Delete"
            }
          }
        },
        "data": {
          "description": "Mappings between Kubernetes Secret keys and provider data. See https://external-secrets.io/latest/api/externalsecret/ for details.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "dataFrom": {
          "description": "Provider data sources whose values are merged into the target Secret. See https://external-secrets.io/latest/api/externalsecret/ for details.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "secretStoreRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "description": "Kind of the SecretStore resource.",
          "type": "string",
          "enum": [
            "SecretStore",
            "ClusterSecretStore"
          ]
        },
        "name": {
          "description": "Name of the SecretStore resource.",
          "type": "string"
        }
      }
    }
  }
}
