{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bjw-s-labs/helm-charts/common-5.0.0/charts/library/common/schemas/containers.json",
  "$defs": {
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Set to false to disable the container.",
          "type": "boolean",
          "default": true
        },
        "args": {
          "description": "Arguments for the container entrypoint.",
          "$ref": "#/$defs/args"
        },
        "command": {
          "description": "Command for the container entrypoint.",
          "$ref": "#/$defs/command"
        },
        "dependsOn": {
          "description": "Specify container dependencies to determine render order.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "env": {
          "description": "Environment variables for the container.",
          "$ref": "#/$defs/env"
        },
        "envFrom": {
          "description": "Secrets and/or ConfigMaps to load as environment variables.",
          "$ref": "#/$defs/envFrom"
        },
        "image": {
          "description": "Image configuration for the container.",
          "$ref": "#/$defs/image"
        },
        "lifecycle": {
          "description": "Lifecycle event hooks for the container.",
          "$ref": "k8s-api.json#/$defs/core.v1.Lifecycle"
        },
        "nameOverride": {
          "description": "Override the container name.",
          "type": "string"
        },
        "ports": {
          "description": "Ports to expose from the container.",
          "type": "array",
          "items": {
            "$ref": "k8s-api.json#/$defs/core.v1.ContainerPort"
          }
        },
        "probes": {
          "description": "Probe settings for the container.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "liveness": {
              "description": "Liveness probe configuration.",
              "$ref": "#/$defs/probe"
            },
            "readiness": {
              "description": "Readiness probe configuration.",
              "$ref": "#/$defs/probe"
            },
            "startup": {
              "description": "Startup probe configuration.",
              "$ref": "#/$defs/probe"
            }
          }
        },
        "resources": {
          "description": "Resource requests and limits for the container.",
          "$ref": "k8s-api.json#/$defs/core.v1.ResourceRequirements"
        },
        "restartPolicy": {
          "description": "Restart policy for the container.",
          "type": "string"
        },
        "securityContext": {
          "description": "Security context for the container.",
          "$ref": "k8s-api.json#/$defs/core.v1.ContainerSecurityContext"
        },
        "stdin": {
          "description": "Keep the standard input open on the container.",
          "type": "boolean",
          "default": false
        },
        "terminationMessagePath": {
          "description": "Path for the container's termination message file.",
          "type": "string"
        },
        "terminationMessagePolicy": {
          "description": "How the container's termination message should be populated. Supported values: 'File', 'FallbackToLogsOnError'.",
          "type": "string",
          "enum": [
            "File",
            "FallbackToLogsOnError"
          ]
        },
        "tty": {
          "description": "Allocate a TTY for the container.",
          "type": "boolean",
          "default": false
        },
        "workingDir": {
          "description": "Working directory for the container.",
          "type": "string"
        }
      }
    },
    "args": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "command": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "env": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "envVars.json#/$defs/envVarListItem"
              },
              {
                "$ref": "envVars.json#/$defs/valueFromListItem"
              }
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "envVars.json#/$defs/envVarValue"
              },
              {
                "$ref": "envVars.json#/$defs/envVarItem"
              },
              {
                "$ref": "envVars.json#/$defs/valueFromItem"
              }
            ]
          }
        }
      ]
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configMap": {
            "type": "string"
          },
          "configMapRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "identifier": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "identifier"
                ]
              }
            ]
          },
          "prefix": {
            "type": [
              "string",
              "null"
            ]
          },
          "secret": {
            "type": "string"
          },
          "secretRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "identifier": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "required": [
                  "name"
                ]
              },
              {
                "required": [
                  "identifier"
                ]
              }
            ]
          }
        }
      }
    },
    "image": {
      "type": "object",
      "allOf": [
        {
          "$ref": "definitions.json#/$defs/imageSpecification"
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "probe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "custom": {
          "type": "boolean",
          "default": false
        },
        "path": {
          "type": "string"
        },
        "port": {
          "type": [
            "number",
            "string"
          ]
        },
        "service": {
          "type": "string"
        },
        "spec": {
          "$ref": "k8s-api.json#/$defs/core.v1.Probe"
        },
        "type": {
          "type": "string",
          "enum": [
            "TCP",
            "HTTP",
            "HTTPS",
            "GRPC",
            "AUTO"
          ]
        }
      }
    }
  }
}
