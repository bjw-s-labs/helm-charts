{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bjw-s-labs/helm-charts/common-5.0.0/charts/library/common/schemas/persistence.json",
  "$defs": {
    "item": {
      "properties": {
        "enabled": {
          "description": "Set to false to disable the persistence item.",
          "type": "boolean",
          "default": true
        },
        "globalMounts": {
          "$ref": "#/$defs/globalMounts",
          "description": "Configure mounts to all controllers and containers.\nBy default the persistence item will be mounted to /<name_of_the_peristence_item>.\nSee https://bjw-s-labs.github.io/helm-charts/docs/common-library/storage/globalOptions/#globalmounts"
        },
        "advancedMounts": {
          "$ref": "#/$defs/advancedMounts",
          "description": "Explicitly configure mounts for specific controllers and containers.\nSee https://bjw-s-labs.github.io/helm-charts/docs/common-library/storage/globalOptions/#advancedmounts"
        }
      },
      "unevaluatedProperties": false,
      "oneOf": [
        { "$ref": "#/$defs/item.type.persistentVolumeClaim" },
        { "$ref": "#/$defs/item.type.persistentVolumeClaimExisting" },
        { "$ref": "#/$defs/item.type.configMap" },
        { "$ref": "#/$defs/item.type.secret" },
        { "$ref": "#/$defs/item.type.nfs" },
        { "$ref": "#/$defs/item.type.emptyDir" },
        { "$ref": "#/$defs/item.type.hostPath" },
        { "$ref": "#/$defs/item.type.image" },
        { "$ref": "#/$defs/item.type.custom" }
      ]
    },

    "item.type.persistentVolumeClaim": {
      "type": "object",
      "allOf": [
        { "$ref": "definitions.json#/$defs/resourceIdentifier" }
      ],
      "required": ["accessMode", "size"],
      "properties": {
        "type": {
          "const": "persistentVolumeClaim"
        },
        "accessMode": {
          "type": "string",
          "description": "AccessMode for the persistent volume. Make sure to select an access mode that is supported by your storage provider!\nSee https://kubernetes.io/docs/concepts/storage/persistent-volumes/#access-modes"
        },
        "annotations": {
          "$ref": "definitions.json#/$defs/annotations"
        },
        "dataSource": {
          "$ref": "#/$defs/dataSourceReference",
          "description": "The optional data source for the persistentVolumeClaim.\nSee https://kubernetes.io/docs/concepts/storage/persistent-volumes/#volume-populators-and-data-sources"
        },
        "dataSourceRef": {
          "$ref": "#/$defs/dataSourceReference",
          "description": "The optional volume populator for the persistentVolumeClaim.\nSee https://kubernetes.io/docs/concepts/storage/persistent-volumes/#volume-populators-and-data-sources"
        },
        "labels": {
          "$ref": "definitions.json#/$defs/labels"
        },
        "retain": {
          "type": "boolean",
          "description": "Set to true to retain the PVC upon helm uninstall."
        },
        "size": {
          "type": "string",
          "description": "The amount of storage that is requested for the persistent volume."
        },
        "storageClass": {
          "type": "string",
          "description": "Storage Class for the config volume.\nIf set to '-', dynamic provisioning is disabled.\nIf set to something else, the given storageClass is used.\nIf undefined (the default) or set to null, no storageClassName spec is set, choosing the default provisioner."
        },
        "volumeName": {
          "type": "string"
        }
      }
    },

    "item.type.persistentVolumeClaimExisting": {
      "type": "object",
      "required": ["existingClaim"],
      "properties": {
        "type": {
          "const": "persistentVolumeClaim"
        },
        "existingClaim": {
          "type": "string",
          "description": "The name of an existing PersistentVolumeClaim to use. Helm templates are supported.\nThis will not create a new PVC, but use the existing one instead."
        }
      }
    },

    "item.type.configMap": {
      "type": "object",
      "required": ["type"],
      "$comment": "oneOf enforces that at least one of name/identifier is present. dependentSchemas enforces mutual exclusion with a targeted error when both are set. Both are needed — do not simplify to oneOf alone.",
      "oneOf": [
        { "required": ["name"] },
        { "required": ["identifier"] }
      ],
      "dependentSchemas": {
        "name": { "not": { "required": ["identifier"] } },
        "identifier": { "not": { "required": ["name"] } }
      },
      "properties": {
        "type": {
          "const": "configMap"
        },
        "name": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "defaultMode": {
          "type": "integer",
          "format": "int32"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "mode": { "format": "int32", "type": "integer" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },

    "item.type.secret": {
      "type": "object",
      "required": ["type"],
      "$comment": "oneOf enforces that at least one of name/identifier is present. dependentSchemas enforces mutual exclusion with a targeted error when both are set. Both are needed — do not simplify to oneOf alone.",
      "oneOf": [
        { "required": ["name"] },
        { "required": ["identifier"] }
      ],
      "dependentSchemas": {
        "name": { "not": { "required": ["identifier"] } },
        "identifier": { "not": { "required": ["name"] } }
      },
      "properties": {
        "type": {
          "const": "secret"
        },
        "name": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "defaultMode": {
          "type": "integer",
          "format": "int32"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "mode": { "format": "int32", "type": "integer" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },

    "item.type.nfs": {
      "type": "object",
      "required": ["type", "server", "path"],
      "properties": {
        "type": {
          "const": "nfs"
        },
        "path": {
          "type": "string"
        },
        "server": {
          "type": "string"
        }
      }
    },

    "item.type.emptyDir": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "emptyDir"
        },
        "medium": {
          "type": "string"
        },
        "sizeLimit": {
          "type": "string"
        }
      }
    },

    "item.type.hostPath": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "hostPath"
        },
        "hostPath": {
          "type": "string"
        },
        "hostPathType": {
          "type": "string"
        }
      }
    },

    "item.type.image": {
      "type": "object",
      "required": ["type", "image"],
      "properties": {
        "type": {
          "const": "image"
        },
        "image": {
          "description": "OCI artifact reference to be used.",
          "oneOf": [
            { "type": "string" },
            { "$ref": "definitions.json#/$defs/imageSpecification" }
          ]
        },
        "pullPolicy": {
          "description": "The image pull policy for the image persistence item.",
          "type": "string",
          "enum": ["Always", "Never", "IfNotPresent"]
        }
      }
    },

    "item.type.custom": {
      "type": "object",
      "required": ["type", "volumeSpec"],
      "properties": {
        "type": {
          "const": "custom"
        },
        "volumeSpec": {
          "type": "object"
        }
      }
    },

    "dataSourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "apiGroup": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },

    "globalMounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mountPath"
      }
    },

    "advancedMounts": {
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/mountPathCollection"
        }
      }
    },

    "mountPathCollection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mountPath"
      }
    },

    "mountPath": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "The path where the volume should be mounted in the container. Helm templates are supported.\nIf not specified, the mount path will be set to /<identifier_of_the_peristence_item>."
        },
        "readOnly": {
          "type": "boolean"
        },
        "subPath": {
          "type": "string",
          "description": "The subPath within the volume to mount. Helm templates are supported.\nIf not specified, the entire volume will be mounted."
        },
        "subPathExpr": {
          "type": "string"
        },
        "mountPropagation": {
          "type": "string"
        }
      }
    }
  }
}
